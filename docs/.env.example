APP_NAME=THOB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost
APP_LOCALE=ar

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (SRS: single MySQL DB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thob
DB_USERNAME=root
DB_PASSWORD=

# --- Session / Cache / Queue ---
# shared-hosting-compatible defaults; swap to redis only when moving off shared hosting (Section 20)
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Auth (Sanctum) ---
SANCTUM_STATEFUL_DOMAINS=localhost

# --- OTP / SMS Provider (SI-FR-02) ---
OTP_SMS_PROVIDER=
OTP_SMS_API_KEY=
OTP_SMS_SENDER_ID=
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# --- S3 Media (Section 12) ---
# Public disk: product media served via CDN
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET_PUBLIC=thob-media-public
AWS_BUCKET_PRIVATE=thob-verification-private
AWS_URL=
CDN_URL=

# --- Pusher (Chat — Section 4.5) ---
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# --- Push Notifications (SI-FR-04) ---
PUSH_NOTIFICATION_PROVIDER=
PUSH_NOTIFICATION_KEY=

# --- Payment Provider (R4 — SI-FR-03, SEC-NFR-07) ---
# subscription billing (R1) + order payment (R4) share this provider client
# but are handled by isolated flows per BR-PAY-02
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Maps Provider (R3 — SI-FR-05) ---
MAPS_PROVIDER=
MAPS_API_KEY=

# --- Feature Flags (release gating, Section 20/13 of prompts) ---
FEATURE_ORDERS=false
FEATURE_RETAILER=false
FEATURE_CUSTOMER=false
FEATURE_LOCATIONS=false
FEATURE_ONLINE_PAYMENT=false
FEATURE_SHIPPING=false
