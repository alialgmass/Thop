APP_NAME=THOB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------------
# Local/dev default: SQLite. Production target: MySQL 8 (uncomment the block).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=thob
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@thob.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Auth / OTP (Modules/Auth) ----------------------------------------------
# OtpSender binding. `log` records only that a code was issued, never the code
# (SEC-NFR-02). `capture` (local/testing ONLY — refused in production) stashes the
# plaintext in the cache under `otp:{phone}` so you can read it back while testing
# the flow by hand. Add real SMS-provider keys under AuthServiceProvider::OTP_DRIVERS.
OTP_DRIVER=log

# --- Verification documents (Modules/Verification) --------------------------
# Disk name + driver for verification documents. `local` in dev; `s3` (private
# bucket, SSE) in production.
VERIFICATION_DISK=verification
VERIFICATION_DISK_DRIVER=local

# --- Catalog review gating (Modules/Catalog, BR-SEL-02) --------------------
# New products enter pending_review before going public when true. A material
# edit re-enters review when CATALOG_REVIEW_EDIT is true (default off).
CATALOG_REVIEW_CREATE=true
CATALOG_REVIEW_EDIT=false

# --- S3 (verification docs in prod; product media later) -------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Telescope (local debugging) -----------------------------------------------
TELESCOPE_ENABLED=true

# --- Later phases (not wired yet) --------------------------------------------
# Chat (Phase 7): PUSHER_APP_ID / PUSHER_APP_KEY / PUSHER_APP_SECRET / PUSHER_APP_CLUSTER
# Payments (R4): payment-provider hosted-checkout keys — no card data ever touches THOB
